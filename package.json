{
  "name": "realestate-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend API for the RealEstateBroker platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11 <21"
  },
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "worker": "tsx src/worker.ts",
    "build": "nest build",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.ts\"",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --selectProjects unit",
    "test:integration": "jest --config jest.config.ts --selectProjects integration",
    "test:e2e": "jest --config jest.config.ts --selectProjects e2e",
    "test:contract": "jest --config jest.config.ts --selectProjects contract",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "seed:locations": "tsx scripts/seed-locations.ts",
    "db:wait": "tsx scripts/wait-for-postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "make:admin": "tsx scripts/make-admin.ts",
    "push:test": "tsx scripts/send-test-push.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.9.0",
    "@supabase/supabase-js": "^2.49.8",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^12.1.1",
    "joi": "^17.13.1",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.0.7",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@openapitools/openapi-generator-cli": "^2.13.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "chai": "^5.1.1",
    "chai-openapi-response-validator": "^0.14.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "@testcontainers/postgresql": "^10.28.0",
    "prisma": "^6.9.0",
    "testcontainers": "^10.28.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
