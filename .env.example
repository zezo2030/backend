# Runtime environment: development, test, or production.
NODE_ENV=development

# HTTP port for the NestJS API process.
PORT=3000

# Bind address (0.0.0.0 lets phones on the same Wi‑Fi reach the API).
HOST=0.0.0.0

# Supabase Postgres — transaction pooler for the running API (port 6543).
# Copy the exact pooler hostname from Dashboard → Database → Connection string (may be aws-0 or aws-1).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler for Prisma migrations (port 5432 on the same pooler host).
# Use db.[PROJECT-REF].supabase.co:5432 only if direct connections work from your network.
# Migrations must run as a role that OWNS the tables (usually postgres). If DATABASE_URL uses
# a limited role (e.g. app_backend) and migrate deploy fails with "must be owner of table",
# apply pending SQL from prisma/migrations via Supabase Dashboard → SQL, then:
#   npx prisma migrate resolve --applied <migration_folder_name>
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Optional dedicated URL for Jest when Docker/Testcontainers is unavailable.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate_test

# Supabase project URL (Dashboard → Project Settings → API).
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Service role key — server-side only, never ship to mobile/web clients.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Public storage bucket for property images and avatars.
SUPABASE_STORAGE_BUCKET=property-media

# Signed upload URL lifetime in seconds (client-facing expiresAt).
SUPABASE_STORAGE_PRESIGN_TTL_SEC=600

# HS256 secret for short-lived access tokens; replace before booting locally.
JWT_ACCESS_SECRET=replace-with-hex-secret

# Access token lifetime in seconds.
JWT_ACCESS_TTL_SEC=86400

# Pepper used before hashing refresh tokens; replace before booting locally.
JWT_REFRESH_SECRET=replace-with-hex-secret

# Refresh token lifetime in seconds.
JWT_REFRESH_TTL_SEC=2592000

# Firebase project (FCM). Example: al-waseet-al-iqari — see docs/firebase-push-setup.md.
FIREBASE_PROJECT_ID=al-waseet-al-iqari

# Preferred: path to service-account JSON from Firebase Console (server-only, gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Alternative to FIREBASE_SERVICE_ACCOUNT_PATH when PUSH_PROVIDER=fcm.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Push adapter: fcm (real devices) or stub (local/tests).
PUSH_PROVIDER=stub

# Maximum accepted uploaded image size in bytes.
IMAGE_MAX_BYTES=8388608

# Maximum accepted uploaded video size in bytes (default 100 MB).
VIDEO_MAX_BYTES=104857600

# Auto-compress property images/videos when a listing is created or updated.
MEDIA_COMPRESSION_ENABLED=true
# Resize wider images to this max width and store as WebP.
IMAGE_MAX_DIMENSION=1920
IMAGE_WEBP_QUALITY=80
# Skip re-encoding when the uploaded WebP is already under this size (bytes).
IMAGE_SKIP_BELOW_BYTES=307200
# Transcode large videos to H.264 MP4 capped at this height (720p by default).
VIDEO_MAX_HEIGHT=720
VIDEO_CRF=28
# Skip transcoding when the uploaded video is already under this size (bytes).
VIDEO_SKIP_BELOW_BYTES=5242880
# FFmpeg timeout per video in milliseconds.
VIDEO_TRANSCODE_TIMEOUT_MS=120000

# Sole owner / super-admin account. The matching user is force-promoted to
# isOwner+Admin on boot and is protected from edits by any other admin.
OWNER_EMAIL=mhd7190@gmail.com

# Android App Links — makes https://<host>/listing/:id open the app directly.
# Served at https://riden74.com/.well-known/assetlinks.json
#
# Preferred: keep the JSON from Google Play Console in .well-known/assetlinks.json
# (copied automatically when the API starts). Or set ANDROID_ASSET_LINKS_JSON to the
# full JSON array on one line.
#
# Legacy single-app env vars (used only when no assetlinks file / JSON override):
# ANDROID_PACKAGE_NAME defaults to com.riden74.app
ANDROID_PACKAGE_NAME=com.riden74.app
ANDROID_CERT_SHA256=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
#
# Optional second app (credential sharing / Smart Lock):
# ANDROID_PACKAGE_NAME_2=com.riden74.app
# ANDROID_CERT_SHA256_2=<SHA-256 from Play Console>
# ANDROID_RELATIONS_2=delegate_permission/common.handle_all_urls,delegate_permission/common.get_login_creds

# Run fanout worker in the API process during local development.
DEV_RUN_WORKER=true

# Pino log level.
LOG_LEVEL=info

# Comma-separated browser origins for CORS (web admin). Example:
# CORS_ORIGINS=https://readstatadmin.vercel.app,http://localhost:5173
# CORS_ORIGINS=

# Email for password reset: stub (logs in tests) or smtp.
MAIL_PROVIDER=stub
# Preferred names (MAIL_*) or aliases (SMTP_*):
MAIL_FROM="3qarat <noreply@yourdomain.com>"
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Password reset limits (optional overrides).
# PASSWORD_RESET_CODE_TTL_SEC=600
# PASSWORD_RESET_TOKEN_TTL_SEC=900
# PASSWORD_RESET_MAX_ATTEMPTS=5
# PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
